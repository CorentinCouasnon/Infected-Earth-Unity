// only function that is called on map init, runs all initialization functions
bool MapInit_Main(bool testConds, bool runActions) {
    
    UI_Init();
    Camera_Init();
    Chat_Init();
    Region_Init();
    Player_Init();
    Enemy_Init();
    Wave_Init();
    GameManager_InitPart(c_Part_Terran);
    
    return true;
}
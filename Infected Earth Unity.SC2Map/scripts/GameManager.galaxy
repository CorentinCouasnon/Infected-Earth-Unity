void GameManager_StartNewWave()
{
    gv_currentWave += 1;

    if (gv_currentWave == c_waveCountToWin) 
    {
        GameOver(1, c_gameOverVictory, true, true);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText("Victoire ! Vague " + IntToString(c_waveCountToWin) + " atteinte !"));
        return;
    } 
    else 
    {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText("Début de la vague " + IntToString(gv_currentWave) + "..."));
    }

    Boss_OnNewWave();
    Wave_OnNewWave();
    Wave_StartTimer();
}

bool GameManager_CheckWaveStatus(bool testConds, bool runActions)
{
    if (f_isWaveInProgress && !f_isWaveTimerElapsed)
    {
        return true;
    }

    if (gv_currentWave == c_terranLastWave || gv_currentWave == c_protossLastWave || gv_currentWave == c_zergLastWave)
    {
        if (!f_sendWaveFlag)
        {
            return true;
        }
    }

    GameManager_StartNewWave();
    f_sendWaveFlag = false;

    return true;
}

void GameManager_StartPart(int part)
{
    gv_currentPart = part;

    if (part == c_Part_Terran)
    {
        Player_TeleportToPoint(PointFromName("Terran_SpawnPoint"));
        CameraSetBounds(PlayerGroupAll(), RegionFromName("Terran_All"), true);
    } 
    else if (part == c_Part_Protoss)
    {
        Player_TeleportToPoint(PointFromName("Protoss_SpawnPoint"));
        CameraSetBounds(PlayerGroupAll(), RegionFromName("Protoss_All"), true);
    }
    else
    {
        Player_TeleportToPoint(PointFromName("Zerg_SpawnPoint"));
        CameraSetBounds(PlayerGroupAll(), RegionFromName("Zerg_All"), true);
    }

    f_sendWaveFlag = true;
}

bool GameManager_OnUnitDeath(bool testConds, bool runActions)
{
    if (gv_currentWave != c_terranLastWave && gv_currentWave != c_protossLastWave && gv_currentWave != c_zergLastWave)
    {
        return true;
    }

    if (gv_enemiesAlive > 0)
    {
        return true;
    }

    if (gv_currentPart == c_Part_Terran)
    {
        Player_SpawnEscapeShip(PointFromName("Terran_SpawnPoint"));
    } 
    else if (gv_currentPart == c_Part_Protoss)
    {
        Player_SpawnEscapeShip(PointFromName("Protoss_SpawnPoint"));
    }
    else
    {
        Player_SpawnEscapeShip(PointFromName("Zerg_SpawnPoint"));
    }

    return true;
}

bool GameManager_OnEscapeAbilityUsed(bool testConds, bool runActions)
{
    if (gv_currentPart == c_Part_Terran)
    {
        GameManager_StartPart(c_Part_Protoss);
    } 
    else if (gv_currentPart == c_Part_Protoss)
    {
        GameManager_StartPart(c_Part_Zerg);
    }
    else
    {
        GameManager_StartPart(c_Part_Terran);
    }

    return true;
}

void GameManager_Init()
{
    GameManager_StartPart(c_Part_Terran);

    TriggerAddEventTimePeriodic(TriggerCreate("GameManager_CheckWaveStatus"), c_minimumTickTime, c_timeGame);
    TriggerAddEventUnitDied(TriggerCreate("GameManager_OnUnitDeath"), null);
    TriggerAddEventUnitAbility(TriggerCreate("GameManager_OnEscapeAbilityUsed"), null, AbilityCommand("EscapeShipGoToNextPart", 0), c_abilEffectStageChannel, false);
}
void Player_CreateHeroUnit(int player)
{
    string heroUnit;

    if (gv_playersData[player - 1].selectedHeroIndex == 0)
    {
        heroUnit = "JimRaynorIEUHero";
    }
    else if (gv_playersData[player - 1].selectedHeroIndex == 1)
    {
        heroUnit = "ZeratulIEUHero";
    }
    else
    {
        heroUnit = "";
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(1, heroUnit, 0, player, PointFromName("Terran_SpawnPoint"));
    gv_playersData[player - 1].heroUnit = UnitLastCreated();
    Camera_FocusOnUnit(player, gv_playersData[player - 1].heroUnit);
}

void Player_KillReward(int player, point deadUnitPosition)
{
    int rewardValue;
    int arrayCount;
    int i;
    unit killedUnit = EventUnit();
    string instanceUnit;

    // Récupère le nombre d'instances dans le tableau KillRewardTable
    arrayCount = UserDataInstanceCount("KillRewardTable");

    rewardValue = 0;

    // Parcourt la table pour trouver l'unité correspondante
    for (i = 1; i <= arrayCount; i += 1)
    {
        instanceUnit = UserDataGetUnit("KillRewardTable", IntToString(i), "unit", 1);

        if (UnitGetType(killedUnit) == instanceUnit)
        {
            rewardValue = UserDataGetInt("KillRewardTable", IntToString(i), "ressourceCount", 1);

            if (rewardValue != 0)
            {
                // Application de la récompense
                PlayerModifyPropertyFixed(player, c_playerPropMinerals, c_playerPropOperAdd, rewardValue);
                UI_DelayedTextTagCreate(StringToText("+") + FixedToText(rewardValue, 0), Color(20, 60, 90), deadUnitPosition, PlayerGroupSingle(player), 1.0, 2.0);
            }

            rewardValue = UserDataGetInt("KillRewardTable", IntToString(i), "ressourceCount", 2);

            if (rewardValue != 0)
            {
                // Application de la récompense
                PlayerModifyPropertyFixed(player, c_playerPropVespene, c_playerPropOperAdd, rewardValue);
                UI_DelayedTextTagCreate(StringToText("+") + FixedToText(rewardValue, 0), Color(20, 90, 60), deadUnitPosition, PlayerGroupSingle(player), 3.0, 2.0);
            }

            break;
        }
    }
}

bool Player_OnUnitDeath(bool testConds, bool runActions)
{
    int killingPlayer = libNtve_gf_KillingPlayer();
    int killedUnitPlayer = EventPlayer();
    unit killedUnit = EventUnit();

    if (killedUnitPlayer >= 1 && killedUnitPlayer <= 6 && !UnitIsAlive(gv_playersData[killedUnitPlayer - 1].heroUnit))
    {
       GameOver(killedUnitPlayer, c_gameOverDefeat, true, true);
    }

    if (killingPlayer >= 1 && killingPlayer <= 6 && killedUnitPlayer == 15)
    {
        Player_KillReward(killingPlayer, UnitGetPosition(killedUnit));
    }

    return true;
}

bool Player_OnAbilityUsed(bool testConds, bool runActions)
{
    abilcmd abilityUsed;
    int triggeringPlayer;

    triggeringPlayer = EventPlayer();

    if (triggeringPlayer < 1 || triggeringPlayer > 6)
    {
        return true;
    }

    abilityUsed = EventUnitAbility();

    //Debug_ShowMessage("Ability utilisé : " + AbilityCommandGetAbility(abilityUsed));

    return true;
}

void Player_SpawnEscapeShip(point p)
{
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "EscapeShip", 0, 7, p);
}

void Player_TeleportToPoint(point p)
{
    int tmpPlayer = -1;

    while (true) 
    {
        tmpPlayer = PlayerGroupNextPlayer(PlayerGroupActive(), tmpPlayer);
        if (tmpPlayer < 0) { break; }

        if (gv_playersData[tmpPlayer - 1].heroUnit == null)
        {
            continue;
        }
        
        UnitSetPosition(gv_playersData[tmpPlayer - 1].heroUnit, p, false);
    }
}

void Player_SetStartingRessources()
{
    int tmpPlayer = -1;

    while (true) 
    {
        tmpPlayer = PlayerGroupNextPlayer(PlayerGroupActive(), tmpPlayer);
        if (tmpPlayer < 0) { break; }
        PlayerModifyPropertyFixed(tmpPlayer, c_playerPropMinerals, c_playerPropOperAdd, c_playerStartingMinerals);
        PlayerModifyPropertyFixed(tmpPlayer, c_playerPropVespene, c_playerPropOperAdd, c_playerStartingVespene);
    }
}

void Player_Init()
{
    Player_SetStartingRessources();

    TriggerAddEventUnitDied(TriggerCreate("Player_OnUnitDeath"), null);
    TriggerAddEventUnitAbility(TriggerCreate("Player_OnAbilityUsed"), null, null, c_abilEffectStageChannel, false);
}
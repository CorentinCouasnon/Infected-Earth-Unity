static int heroSelection_frame;
static int[3] heroSelection_chooseHeroButtons;

bool UI_HeroSelection_OnHeroSelected(bool testConds, bool runActions)
{
    int player = EventPlayer();
    int control = EventDialogControl();
    int i;

    // TODO : Remove magic number
    for(i = 0; i < 3; i += 1)
    {
        if (heroSelection_chooseHeroButtons[i] == control)
        {
            gv_playersData[player - 1].selectedHeroIndex = i;
            Player_CreateHeroUnit(player);
        }
    }

    DialogControlSetVisible(heroSelection_frame, PlayerGroupSingle(player), false);

    return true;
}

void UI_HeroSelection_Init()
{
    trigger heroSelectedTrigger;
    int i;

    heroSelection_frame = DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/HeroSelectionPanel");

    heroSelectedTrigger = TriggerCreate("UI_HeroSelection_OnHeroSelected");

    // TODO : Remove magic number
    for(i = 0; i < 3; i += 1)
    {
        heroSelection_chooseHeroButtons[i] = DialogControlHookup(heroSelection_frame, c_triggerControlTypeButton, "ChooseHero" + IntToString(i + 1));
        TriggerAddEventDialogControl(heroSelectedTrigger, c_playerAny, heroSelection_chooseHeroButtons[i], c_triggerControlEventTypeClick);
    }
}
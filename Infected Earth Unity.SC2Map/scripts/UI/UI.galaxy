void UI_CreateTextTag(text inText, color inColor, point position, playergroup group, fixed offset, fixed duration)
{
    int textTag;
    textTag = TextTagCreate(TextWithColor(inText, inColor), 18, position, offset, true, false, group);
    TextTagSetVelocity(textTag, 1.0, 90.0);
    TextTagSetTime(textTag, c_textTagTimeDuration, duration);
    Wait(duration, c_timeReal);
    TextTagDestroy(textTag);
}

bool UI_Update(bool testConds, bool runActions)
{
    UI_WaveInfo_Update();
    UI_Boss_Update();

    return true;
}

void UI_Init()
{
    UI_WaveInfo_Init();
    UI_HeroSelection_Init();
    UI_Boss_Init();

    TriggerAddEventTimePeriodic(TriggerCreate("UI_Update"), c_minimumTickTime, c_timeGame);
}
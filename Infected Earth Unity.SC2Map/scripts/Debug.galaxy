void Debug_ShowUnitGroupCount(string groupName, unitgroup group)
{
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("[DEBUG] Nombre d'unités du groupe \"") + StringToText(groupName) + StringToText("\" : ") + IntToText(UnitGroupCount(group, 0))
    );
}

void Debug_ShowAbilityExists(string abilityName, unit u)
{
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("[DEBUG] L'ability \"") + StringToText(abilityName) + StringToText("\" existe : ") + IntToText(BoolToInt(UnitAbilityExists(u, abilityName)))
    );
}

void Debug_ShowMessage(string message)
{
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(message));
}

void Debug_ShowMessageInt(string name, int number)
{
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(name + IntToString(number)));
}

void Debug_ShowMessageBool(string name, bool value)
{
    if (value)
    {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(name + " : True"));
    }
    else 
    {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(name + " : False"));
    }
}

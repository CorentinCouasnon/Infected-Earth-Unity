bool Enemy_GroupAttack(bool testConds, bool runActions)
{
    // TODO : Make enemies focus all players
    if (gv_playersData[0].heroUnit == null)
    {
        return true;
    }

    UnitGroupIssueOrder(gv_enemiesGroup, OrderTargetingUnit(AbilityCommand("attack", 0), gv_playersData[0].heroUnit), c_orderQueueReplace);
    return true;
}

void Enemy_Init()
{
    TriggerAddEventTimePeriodic(TriggerCreate("Enemy_GroupAttack"), c_minimumTickTime, c_timeGame);
}
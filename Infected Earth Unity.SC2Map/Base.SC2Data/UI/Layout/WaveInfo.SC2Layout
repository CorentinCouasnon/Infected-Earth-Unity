<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

	<Frame type="Frame" name="GameUI/UIContainer" file="GameUI">
		<Frame type="Frame" name="WaveInfoPanel">
			<Anchor side="Top" relative="$parent" pos="Mid" offset="-150"/>
			<Anchor side="Left" relative="$parent" pos="Min" offset="10"/>
			
			<Height val="150"/>
			<Width val="300"/>

			<Frame type="Image" name="Background">
				<Anchor relative="$parent"/>
				
				<Texture val="Assets/Textures/ui_ingame_tutorial_textborder_terr.dds"/>
				<TextureType val="NineSlice"/>
			</Frame>


			<Frame type="Label" name="Wave">
				<Anchor side="Top" relative="$parent" pos="Min" offset="30"/>
				<Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
				<Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
				
				<Style val="Regular"/>
				<Width val="250"/>
				<Text val="Vague 0"/>
			</Frame>

			<Frame type="Label" name="Timer">
				<Anchor side="Top" relative="$parent" pos="Min" offset="60"/>
				<Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
				<Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
				
				<Style val="Regular"/>
				<Width val="250"/>
				<Text val="New wave in : 0:00"/>
			</Frame>

            <Frame type="Label" name="Enemies">
				<Anchor side="Top" relative="$parent" pos="Min" offset="90"/>
				<Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
				<Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
				
				<Style val="Regular"/>
				<Width val="250"/>
				<Text val="Ennemies restants : 0"/>
			</Frame>

		</Frame>
	</Frame>

</Desc>
